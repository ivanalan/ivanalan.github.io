---
import BackLink from "@/components/BackLink.astro";
import ProjectMeta from "@/components/ProjectMeta.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const [work, sideProjects] = await Promise.all([
    getCollection("work"),
    getCollection("sideProjects"),
  ]);

  return [...work, ...sideProjects].map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const backHref = entry.collection === "sideProjects" ? "/side-projects" : "/";
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.summary} type="article">
  <article id="main" class="flex flex-col">
    <BackLink href={backHref} />
    <header class="mb-14 flex flex-col gap-3">
      <h1
        class="reveal text-4xl leading-tight text-foreground md:text-5xl"
        style="--reveal-index: 1"
      >
        {entry.data.title}
      </h1>
      <p
        class="reveal text-base text-muted-foreground"
        style="--reveal-index: 2"
      >
        {entry.data.summary}
      </p>
      <ProjectMeta
        role={entry.data.role}
        team={entry.data.team}
        year={entry.data.year}
      />
    </header>
    <div class="case-study flex flex-col">
      {
        entry.data.status === "published" ? (
          <Content />
        ) : (
          <Fragment>
            <h2>Write-up in progress</h2>
            <p class="max-w-prose text-base text-muted-foreground">
              The full case study is being written. It will cover the problem,
              the decisions that mattered, and what shipped.
            </p>
            <div class="flex max-w-prose flex-col" aria-hidden="true">
              <div class="skeleton skeleton-heading w-[32%]" />
              <div class="mt-6 flex flex-col gap-[0.8rem]">
                <div class="skeleton skeleton-line w-[99%]" />
                <div class="skeleton skeleton-line w-[95%]" />
                <div class="skeleton skeleton-line w-[52%]" />
              </div>
              <div class="skeleton skeleton-heading mt-10 w-[44%]" />
              <div class="mt-6 flex flex-col gap-[0.8rem]">
                <div class="skeleton skeleton-line w-[97%]" />
                <div class="skeleton skeleton-line w-full" />
                <div class="skeleton skeleton-line w-[41%]" />
              </div>
            </div>
          </Fragment>
        )
      }
    </div>
  </article>
</Layout>
