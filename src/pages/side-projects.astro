---
import Layout from "@/layouts/Layout.astro";
import SiteIntro from "@/components/SiteIntro.astro";
import { WorkTabs } from "@/components/WorkTabs";
import { getWorkCards } from "@/lib/work-cards";

const { work, sideProjects } = await getWorkCards();
---

<Layout>
  <main id="main" class="flex flex-col gap-8">
    <SiteIntro />
    <WorkTabs
      client:load
      work={work}
      sideProjects={sideProjects}
      defaultTab="side-projects"
    />
  </main>
</Layout>
