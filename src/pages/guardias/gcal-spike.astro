---
/**
 * Throwaway spike: compare Google Calendar add-to-calendar paths on real phones.
 * Open /guardias/gcal-spike on iOS Safari + Android Chrome with GCal installed.
 */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GCal spike — DeGuardia</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#171616" />
    <style is:inline>
      :root {
        color-scheme: dark;
        --fg: #f2f2f2;
        --muted: #aaa;
        --bg: #171616;
        --border: color-mix(in srgb, #fff 12%, transparent);
        --ok: #3d9a6a;
        --font: ui-monospace, Menlo, monospace;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        font-family: var(--font);
        font-size: 0.88rem;
        font-weight: 400;
        background: var(--bg);
        color: var(--fg);
        padding: 1.25rem 1rem 2.5rem;
        box-sizing: border-box;
      }
      main {
        width: min(26rem, 100%);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      h1 {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 600;
      }
      p,
      li {
        margin: 0;
        color: var(--muted);
        line-height: 1.4;
      }
      .card {
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        padding: 0.85rem 0.9rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }
      .card h2 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--fg);
      }
      .meta {
        font-variant-numeric: tabular-nums;
        white-space: pre-wrap;
        word-break: break-word;
        color: var(--fg);
        font-size: 0.8rem;
        line-height: 1.35;
      }
      .dates {
        max-height: 8rem;
        overflow: auto;
        border: 1px solid var(--border);
        border-radius: 0.5rem;
        padding: 0.5rem 0.65rem;
        color: var(--fg);
        font-size: 0.78rem;
        line-height: 1.45;
      }
      button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 0.85rem 0.9rem;
        border: 1px solid var(--border);
        border-radius: 0.75rem;
        background: transparent;
        color: var(--fg);
        font-family: var(--font);
        font-size: 0.86rem;
        text-align: left;
        cursor: pointer;
      }
      button:active {
        background: color-mix(in srgb, #fff 8%, transparent);
      }
      button strong {
        display: block;
        margin-bottom: 0.2rem;
        font-weight: 600;
      }
      button span {
        display: block;
        color: var(--muted);
        font-size: 0.78rem;
        line-height: 1.3;
      }
      .pass {
        color: var(--ok);
      }
      ol {
        margin: 0;
        padding-left: 1.2rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }
      .stack {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>GCal mobile spike</h1>
      <p>
        Fixed fixture. Tap each path on a phone with Google Calendar installed.
        Pass = series (or all dates) visible on calendar.google.com web within a
        minute.
      </p>

      <section class="card">
        <h2>Fixture</h2>
        <div class="meta" id="fixture-meta"></div>
        <div class="dates" id="shift-dates"></div>
      </section>

      <section class="card">
        <h2>Pass criteria</h2>
        <ol>
          <li>Title: <span class="pass">GCal Spike Rotation</span></li>
          <li>Interval every <span class="pass">4</span> days</li>
          <li>Starts <span class="pass">2026-10-06 07:00</span> local</li>
          <li>All listed shift dates present (or one RRULE series covering them)</li>
          <li>Fail if GCal app shows a single non-repeating event only</li>
        </ol>
      </section>

      <section class="card">
        <h2>Device</h2>
        <div class="meta" id="device-meta"></div>
      </section>

      <section class="stack" aria-label="Candidate flows">
        <button type="button" id="flow-a">
          <strong>A — TEMPLATE + recur</strong>
          <span>Current production Google Calendar link</span>
        </button>
        <button type="button" id="flow-b">
          <strong>B — RRULE .ics + Google import</strong>
          <span>Download one recurring event, open import settings</span>
        </button>
        <button type="button" id="flow-c">
          <strong>C — Expanded .ics only</strong>
          <span>Current Download .ics style (one VEVENT per shift)</span>
        </button>
        <button type="button" id="flow-d">
          <strong>D — RRULE .ics download</strong>
          <span>Blob download (often lands in Files)</span>
        </button>
        <button type="button" id="flow-e">
          <strong>E — Apple Calendar (data: URL)</strong>
          <span>RRULE .ics via data: — should open Add to Calendar on iOS</span>
        </button>
      </section>

      <section class="card">
        <h2>Last action</h2>
        <div class="meta" id="last-action">None yet</div>
      </section>
    </main>

    <script>
      (function () {
        type Draft = {
          label: string;
          startDate: string;
          endDate: string;
          cycleDays: 4;
          shiftStartTime: string;
          firstShiftDate: string;
        };

        /** Clean 4-day cycle, short window — easy to count by eye. */
        var FIXTURE: Draft = {
          label: "GCal Spike Rotation",
          startDate: "2026-10-06",
          endDate: "2026-10-30",
          cycleDays: 4,
          shiftStartTime: "07:00",
          firstShiftDate: "2026-10-06",
        };

        function parseLocalDate(iso: string): Date {
          var parts = iso.split("-");
          return new Date(
            Number(parts[0]),
            Number(parts[1]) - 1,
            Number(parts[2]),
          );
        }

        function toISODate(date: Date): string {
          var y = date.getFullYear();
          var m = String(date.getMonth() + 1).padStart(2, "0");
          var d = String(date.getDate()).padStart(2, "0");
          return y + "-" + m + "-" + d;
        }

        function addDays(iso: string, n: number): string {
          var date = parseLocalDate(iso);
          date.setDate(date.getDate() + n);
          return toISODate(date);
        }

        function daysBetween(a: string, b: string): number {
          var ms =
            parseLocalDate(b).getTime() - parseLocalDate(a).getTime();
          return Math.round(ms / 86400000);
        }

        function isShiftDay(draft: Draft, iso: string): boolean {
          if (iso < draft.startDate || iso > draft.endDate) return false;
          var days = daysBetween(draft.firstShiftDate, iso);
          return ((days % draft.cycleDays) + draft.cycleDays) % draft.cycleDays === 0;
        }

        function listShifts(draft: Draft): string[] {
          var out: string[] = [];
          var cursor = draft.startDate;
          while (cursor <= draft.endDate) {
            if (isShiftDay(draft, cursor)) out.push(cursor);
            cursor = addDays(cursor, 1);
          }
          return out;
        }

        function pad2(n: number): string {
          return String(n).padStart(2, "0");
        }

        function formatIcsLocal(isoDate: string, hhmm: string): string {
          var parts = hhmm.split(":");
          return isoDate.replace(/-/g, "") + "T" + parts[0] + parts[1] + "00";
        }

        function formatIcsUtcNow(): string {
          var d = new Date();
          return (
            d.getUTCFullYear() +
            pad2(d.getUTCMonth() + 1) +
            pad2(d.getUTCDate()) +
            "T" +
            pad2(d.getUTCHours()) +
            pad2(d.getUTCMinutes()) +
            pad2(d.getUTCSeconds()) +
            "Z"
          );
        }

        function escapeIcsText(value: string): string {
          return String(value)
            .replace(/\\/g, "\\\\")
            .replace(/;/g, "\\;")
            .replace(/,/g, "\\,")
            .replace(/\r\n|\n|\r/g, "\\n");
        }

        function rrule(draft: Draft, count: number): string {
          return (
            "RRULE:FREQ=DAILY;INTERVAL=" + draft.cycleDays + ";COUNT=" + count
          );
        }

        function buildTemplateUrl(draft: Draft, shifts: string[]): string {
          var first = shifts[0];
          var endDate = addDays(first, 1);
          var dates =
            formatIcsLocal(first, draft.shiftStartTime) +
            "/" +
            formatIcsLocal(endDate, draft.shiftStartTime);
          var params = new URLSearchParams();
          params.set("action", "TEMPLATE");
          params.set("text", draft.label);
          params.set("dates", dates);
          params.set("details", "DeGuardia GCal spike · path A");
          params.set("recur", rrule(draft, shifts.length));
          return (
            "https://calendar.google.com/calendar/render?" + params.toString()
          );
        }

        /** One master event + RRULE (candidate for mobile Google path). */
        function buildRruleIcs(draft: Draft, shifts: string[]): string {
          var first = shifts[0];
          var endDate = addDays(first, 1);
          var stamp = formatIcsUtcNow();
          var summary = escapeIcsText(draft.label);
          var lines = [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//DeGuardia//GCalSpike//EN",
            "CALSCALE:GREGORIAN",
            "METHOD:PUBLISH",
            "BEGIN:VEVENT",
            "UID:gcal-spike-rrule@alanmatias.com",
            "DTSTAMP:" + stamp,
            "DTSTART:" + formatIcsLocal(first, draft.shiftStartTime),
            "DTEND:" + formatIcsLocal(endDate, draft.shiftStartTime),
            "SUMMARY:" + summary,
            "DESCRIPTION:" + escapeIcsText("DeGuardia GCal spike · RRULE ics"),
            rrule(draft, shifts.length),
            "END:VEVENT",
            "END:VCALENDAR",
          ];
          return lines.join("\r\n") + "\r\n";
        }

        /** Production-style: one VEVENT per shift day. */
        function buildExpandedIcs(draft: Draft, shifts: string[]): string {
          var stamp = formatIcsUtcNow();
          var summary = escapeIcsText(draft.label);
          var lines = [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//DeGuardia//GCalSpike//EN",
            "CALSCALE:GREGORIAN",
            "METHOD:PUBLISH",
          ];
          for (var i = 0; i < shifts.length; i += 1) {
            var cursor = shifts[i];
            var endDate = addDays(cursor, 1);
            lines.push(
              "BEGIN:VEVENT",
              "UID:gcal-spike-" + cursor.replace(/-/g, "") + "@alanmatias.com",
              "DTSTAMP:" + stamp,
              "DTSTART:" + formatIcsLocal(cursor, draft.shiftStartTime),
              "DTEND:" + formatIcsLocal(endDate, draft.shiftStartTime),
              "SUMMARY:" + summary,
              "DESCRIPTION:" +
                escapeIcsText("DeGuardia GCal spike · expanded ics"),
              "END:VEVENT",
            );
          }
          lines.push("END:VCALENDAR");
          return lines.join("\r\n") + "\r\n";
        }

        function downloadText(filename: string, body: string, mime: string): void {
          var blob = new Blob([body], { type: mime });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = filename;
          document.body.append(a);
          a.click();
          a.remove();
          window.setTimeout(function () {
            URL.revokeObjectURL(url);
          }, 2000);
        }

        function detectPlatform(): string {
          var ua = navigator.userAgent || "";
          if (/android/i.test(ua)) return "android";
          if (/iPad|iPhone|iPod/.test(ua)) return "ios";
          return "other";
        }

        function setLast(msg: string): void {
          var el = document.getElementById("last-action");
          if (el) el.textContent = msg;
        }

        var shifts = listShifts(FIXTURE);
        var rule = rrule(FIXTURE, shifts.length);
        var templateUrl = buildTemplateUrl(FIXTURE, shifts);

        var fixtureMeta = document.getElementById("fixture-meta");
        if (fixtureMeta) {
          fixtureMeta.textContent = [
            FIXTURE.label,
            FIXTURE.startDate + " → " + FIXTURE.endDate,
            "cycleDays=" + FIXTURE.cycleDays,
            "shiftStart=" + FIXTURE.shiftStartTime,
            "COUNT=" + shifts.length,
            rule,
          ].join("\n");
        }

        var shiftDatesEl = document.getElementById("shift-dates");
        if (shiftDatesEl) {
          shiftDatesEl.textContent = shifts
            .map(function (d, i) {
              return i + 1 + ". " + d;
            })
            .join("\n");
        }

        var deviceMeta = document.getElementById("device-meta");
        if (deviceMeta) {
          deviceMeta.textContent = [
            "platform: " + detectPlatform(),
            "ua: " + (navigator.userAgent || "").slice(0, 160),
          ].join("\n");
        }

        function openAppleCalendarDataUrl(ics: string): void {
          window.location.href =
            "data:text/calendar;charset=utf-8," + encodeURIComponent(ics);
        }

        var flowA = document.getElementById("flow-a");
        var flowB = document.getElementById("flow-b");
        var flowC = document.getElementById("flow-c");
        var flowD = document.getElementById("flow-d");
        var flowE = document.getElementById("flow-e");

        if (flowA) {
          flowA.addEventListener("click", function () {
            setLast("A opened TEMPLATE\n" + templateUrl);
            window.open(templateUrl, "_blank", "noopener,noreferrer");
          });
        }

        if (flowB) {
          flowB.addEventListener("click", function () {
            var ics = buildRruleIcs(FIXTURE, shifts);
            downloadText(
              "gcal-spike-rrule.ics",
              ics,
              "text/calendar;charset=utf-8",
            );
            window.open(
              "https://calendar.google.com/calendar/u/0/r/settings/import",
              "_blank",
              "noopener,noreferrer",
            );
            setLast(
              "B downloaded RRULE .ics + opened Google import\n" + rule,
            );
          });
        }

        if (flowC) {
          flowC.addEventListener("click", function () {
            var ics = buildExpandedIcs(FIXTURE, shifts);
            downloadText(
              "gcal-spike-expanded.ics",
              ics,
              "text/calendar;charset=utf-8",
            );
            setLast(
              "C downloaded expanded .ics (" + shifts.length + " events)",
            );
          });
        }

        if (flowD) {
          flowD.addEventListener("click", function () {
            var ics = buildRruleIcs(FIXTURE, shifts);
            downloadText(
              "gcal-spike-rrule.ics",
              ics,
              "text/calendar;charset=utf-8",
            );
            setLast("D downloaded RRULE .ics only\n" + rule);
          });
        }

        if (flowE) {
          flowE.addEventListener("click", function () {
            var ics = buildRruleIcs(FIXTURE, shifts);
            setLast(
              "E opened Apple Calendar via data: URL\n" +
                rule +
                "\nPick your Google calendar if offered.",
            );
            openAppleCalendarDataUrl(ics);
          });
        }
      })();
    </script>
  </body>
</html>
