---
/** Share landing page. App opens via DeGuardia App button (custom scheme), then store fallback. */
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>A rotation schedule was shared with you — DeGuardia</title>
    <meta
      name="description"
      content="See all shift dates and save it on your device."
    />
    <meta name="apple-itunes-app" content="app-id=6803777786" />
    <meta property="og:title" content="A rotation schedule was shared with you" />
    <meta
      property="og:description"
      content="See all shift dates and save it on your device."
    />
    <meta
      property="og:image"
      content="https://alanmatias.com/media/side-projects/guardias/icon.png"
    />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/media/side-projects/guardias/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@300;400&family=Instrument+Serif&display=swap"
      rel="stylesheet"
    />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#171616" />
    <style is:inline>
      :root {
        color-scheme: dark;
        --fg: #f2f2f2;
        --muted: #aaa;
        --bg: #171616;
        --cta: #f2f2f2;
        --card-border: color-mix(in srgb, #fff 12%, transparent);
        --weekend: #007259;
        --cal-bg: #1c1b1a;
        --cal-fg: #f2f2f2;
        --cal-muted: #6a6864;
        --cal-dow: #9a9894;
        /* Match DeGuardia: Instrument Serif headers, mono body (Inconsolata on web). */
        --font-serif: "Instrument Serif", Georgia, "Times New Roman", serif;
        --font-mono: Inconsolata, ui-monospace, Menlo, monospace;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        font-family: var(--font-mono);
        font-weight: 300;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: var(--bg);
        color: var(--fg);
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 3.5rem 1.5rem 1.5rem;
        box-sizing: border-box;
      }
      main {
        width: min(22rem, 100%);
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }
      .hero {
        margin-bottom: 1.75rem;
      }
      .icon {
        width: 6.375rem;
        height: 6.375rem;
        border-radius: 1.4rem;
        display: block;
        margin: 0 auto;
      }
      .icon[hidden] {
        display: none !important;
      }
      .share-head {
        margin-bottom: 1.25rem;
        text-align: left;
      }
      .share-head[hidden] {
        display: none !important;
      }
      .share-label {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(2rem, 7vw, 2.75rem);
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.02em;
        color: var(--fg);
      }
      .share-meta {
        margin: 0.55rem 0 0;
        font-family: var(--font-mono);
        font-size: 1rem;
        font-weight: 300;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
      }
      .copy {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        margin-bottom: 1.75rem;
      }
      .copy.has-preview {
        display: none;
      }
      h1 {
        margin: 0;
        font-family: var(--font-serif);
        font-size: clamp(1.65rem, 5.5vw, 1.95rem);
        line-height: 1.2;
        letter-spacing: -0.02em;
        font-weight: 400;
      }
      .copy > p {
        margin: 0;
        color: var(--muted);
        line-height: 1.3;
        font-size: 0.95rem;
        font-weight: 300;
      }
      .preview {
        width: 100%;
        box-sizing: border-box;
        background: var(--cal-bg);
        border: none;
        border-radius: 1.5rem;
        padding: 1.1rem 1rem 1.15rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: var(--cal-fg);
      }
      .preview[hidden] {
        display: none !important;
      }
      .cal {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        width: 100%;
      }
      .cal-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.2rem;
        min-height: 1.75rem;
      }
      .cal-month {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 1.75rem;
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--cal-fg);
        text-transform: lowercase;
      }
      .cal-nav {
        display: flex;
        align-items: center;
        gap: 0.15rem;
        flex-shrink: 0;
      }
      .cal-nav-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        border: none;
        border-radius: 0.4rem;
        background: transparent;
        color: var(--cal-fg);
        cursor: pointer;
      }
      .cal-nav-btn ion-icon {
        font-size: 1.05rem;
      }
      .cal-nav-btn:disabled {
        opacity: 0.28;
        cursor: default;
      }
      .cal-nav-btn:not(:disabled):hover {
        background: color-mix(in srgb, #fff 10%, transparent);
      }
      .cal-dows,
      .cal-week,
      .cal-weeks {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        width: 100%;
      }
      .cal-weeks {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        width: 100%;
      }
      .cal-dow {
        text-align: center;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 300;
        color: var(--cal-dow);
        line-height: 1;
        padding-bottom: 0.15rem;
      }
      .cal-week {
        position: relative;
        align-items: center;
      }
      .cal-cell {
        height: 2.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1;
        min-width: 0;
      }
      .cal-mark {
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 0.65rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-mono);
        font-size: 0.875rem;
        font-weight: 300;
        font-variant-numeric: tabular-nums;
        color: var(--cal-fg);
        line-height: 1;
        box-sizing: border-box;
      }
      .cal-mark.outside {
        color: var(--cal-muted);
      }
      .cal-mark.shift {
        color: #fff;
      }
      .cal-mark.weekend {
        color: #fff;
        background: transparent;
      }
      .cal-mark.today {
        border: 1.5px solid var(--cal-fg);
      }
      .cal-mark.today.shift {
        padding: 2px;
      }
      .cal-mark.today.shift .cal-mark-inner {
        width: 100%;
        height: 100%;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
      }
      .cal-weekend-pill {
        position: absolute;
        top: 0;
        height: 2.1rem;
        border-radius: 0.65rem;
        background: var(--weekend);
        left: calc(78.5714% - 1.05rem);
        width: calc(14.2857% + 2.1rem);
        z-index: 0;
      }
      .actions {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
        width: 100%;
      }
      .btn-row {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
        width: 100%;
      }
      a.btn,
      button.btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        box-sizing: border-box;
        width: 100%;
        text-align: center;
        text-decoration: none;
        font-family: var(--font-mono);
        font-weight: 400;
        font-size: 0.9rem;
        border-radius: 999px;
        padding: 0.9rem 1rem;
        border: none;
        cursor: pointer;
        background: var(--cta);
        color: #171616;
      }
      .btn ion-icon {
        font-size: 1.2em;
        flex-shrink: 0;
      }
      a.btn-secondary,
      button.btn-secondary {
        background: transparent;
        color: var(--fg);
        border: 1px solid var(--card-border);
      }
      a.btn-ghost,
      button.btn-ghost {
        background: transparent;
        color: var(--muted);
        border: none;
        padding: 0.45rem 0.5rem;
        text-decoration: underline;
        text-underline-offset: 0.15em;
        font-weight: 300;
      }
      .btn[hidden] {
        display: none !important;
      }
      .store-pair {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.6rem;
        width: 100%;
      }
      .store-pair[hidden] {
        display: none !important;
      }
      .store-pair .btn {
        font-size: 0.78rem;
        padding: 0.85rem 0.5rem;
      }
      .cal-menu {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        width: 100%;
      }
      .cal-menu[hidden] {
        display: none !important;
      }
      .cal-menu-list {
        border: 1px solid var(--card-border);
        border-radius: 1rem;
        overflow: hidden;
        width: 100%;
      }
      .cal-menu-list[hidden] {
        display: none !important;
      }
      .cal-menu-list button {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        width: 100%;
        box-sizing: border-box;
        margin: 0;
        padding: 0.85rem 1rem;
        border: none;
        border-bottom: 1px solid var(--card-border);
        background: transparent;
        color: var(--fg);
        font-family: var(--font-mono);
        font-weight: 400;
        font-size: 0.88rem;
        text-align: left;
        cursor: pointer;
      }
      .cal-menu-list button:last-child {
        border-bottom: none;
      }
      .cal-menu-list button:hover {
        background: color-mix(in srgb, #fff 8%, transparent);
      }
      .cal-menu-list ion-icon {
        font-size: 1.15em;
        flex-shrink: 0;
      }
      #cal-btn ion-icon {
        font-size: 1em;
        flex-shrink: 0;
        transition: transform 0.2s ease;
      }
      #cal-btn[aria-expanded="true"] ion-icon {
        transform: rotate(90deg);
      }
      @media (prefers-reduced-motion: reduce) {
        #cal-btn ion-icon {
          transition: none;
        }
      }
      .png-sheet {
        position: fixed;
        inset: 0;
        z-index: 40;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        padding: 1rem;
        box-sizing: border-box;
        background: color-mix(in srgb, #000 55%, transparent);
      }
      .png-sheet[hidden] {
        display: none !important;
      }
      .png-sheet-panel {
        width: min(22rem, 100%);
        max-height: min(90dvh, 40rem);
        overflow: auto;
        background: var(--bg);
        border: 1px solid var(--card-border);
        border-radius: 1.25rem;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .png-sheet-panel img {
        width: 100%;
        height: auto;
        border-radius: 0.85rem;
        display: block;
        background: #171616;
        -webkit-touch-callout: default;
      }
      .png-sheet-hint {
        margin: 0;
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.35;
        text-align: center;
      }
      .png-sheet-hint[hidden] {
        display: none !important;
      }
      /* Offscreen export: narrow, height hugs stacked months. */
      .export-sheet {
        position: fixed;
        left: -10000px;
        top: 0;
        width: 20rem;
        max-width: 20rem;
        box-sizing: border-box;
        margin: 0;
        padding: 1.35rem 1.1rem 1.15rem;
        background: #171616;
        color: #f2f2f2;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 1.15rem;
        pointer-events: none;
        -webkit-font-smoothing: antialiased;
      }
      .export-head {
        text-align: left;
      }
      .export-label {
        margin: 0;
        font-family: var(--font-serif);
        font-size: 2.35rem;
        font-weight: 400;
        line-height: 1.05;
        letter-spacing: -0.02em;
        color: #f2f2f2;
      }
      .export-meta {
        margin: 0.5rem 0 0;
        font-family: var(--font-mono);
        font-size: 0.95rem;
        font-weight: 300;
        color: #aaa;
        font-variant-numeric: tabular-nums;
      }
      .export-months {
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
        width: 100%;
      }
      .export-month {
        width: 100%;
        box-sizing: border-box;
        background: #1c1b1a;
        border-radius: 1.5rem;
        padding: 1.1rem 1rem 1.15rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        color: #f2f2f2;
      }
      .export-month .cal-month {
        margin: 0;
      }
      .export-brand {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 300;
        line-height: 1.2;
        color: #9a9894;
      }
      .export-brand img {
        width: 1.15rem;
        height: 1.15rem;
        border-radius: 0.28rem;
        display: block;
        flex-shrink: 0;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="hero">
        <img
          class="icon"
          id="icon"
          src="/media/side-projects/guardias/icon.png"
          width="102"
          height="102"
          alt="DeGuardia"
        />
        <div class="share-head" id="share-head" hidden>
          <h1 class="share-label" id="label"></h1>
          <p class="share-meta" id="meta"></p>
        </div>
        <article class="preview" id="preview" hidden>
          <div class="cal" id="cal" aria-label="Rotation calendar">
            <div class="cal-toolbar">
              <p class="cal-month" id="month-label"></p>
              <div class="cal-nav">
                <button
                  type="button"
                  class="cal-nav-btn"
                  id="month-prev"
                  aria-label="Previous month"
                >
                  <ion-icon name="chevron-back" aria-hidden="true"></ion-icon>
                </button>
                <button
                  type="button"
                  class="cal-nav-btn"
                  id="month-next"
                  aria-label="Next month"
                >
                  <ion-icon
                    name="chevron-forward"
                    aria-hidden="true"
                  ></ion-icon>
                </button>
              </div>
            </div>
            <div class="cal-dows" id="dows"></div>
            <div class="cal-weeks" id="weeks"></div>
          </div>
        </article>
      </div>
      <div class="copy" id="copy">
        <h1 id="title">A rotation was shared with you</h1>
        <p id="copy-body">
          Install DeGuardia to review the schedule and save it on your device.
        </p>
      </div>
      <div class="actions">
        <div class="btn-row">
          <a
            class="btn"
            id="store-btn"
            href="https://apps.apple.com/app/id6803777786"
          >
            <ion-icon
              id="store-btn-icon"
              name="logo-apple"
              aria-hidden="true"
            ></ion-icon>
            <span id="store-btn-label">Open in iOS App Store</span>
          </a>
          <div class="store-pair" id="store-pair" hidden>
            <a
              class="btn"
              id="ios-store-btn"
              href="https://apps.apple.com/app/id6803777786"
            >
              <ion-icon name="logo-apple" aria-hidden="true"></ion-icon>
              iOS App Store
            </a>
            <a
              class="btn"
              id="play-store-btn"
              href="https://play.google.com/store/apps/details?id=com.alanmatias.guardias"
            >
              <ion-icon
                name="logo-google-playstore"
                aria-hidden="true"
              ></ion-icon>
              Google Play
            </a>
          </div>
          <button
            type="button"
            class="btn btn-secondary"
            id="ics-mobile-btn"
            hidden
          >
            <ion-icon name="download-outline" aria-hidden="true"></ion-icon>
            Download .ics file
          </button>
          <div class="cal-menu" id="cal-menu" hidden>
            <button
              type="button"
              class="btn btn-secondary"
              id="cal-btn"
              aria-expanded="false"
              aria-controls="cal-menu-list"
            >
              <ion-icon name="chevron-forward" aria-hidden="true"></ion-icon>
              Add to calendar
            </button>
            <div class="cal-menu-list" id="cal-menu-list" hidden role="menu">
              <button type="button" id="gcal-btn" role="menuitem">
                <ion-icon name="logo-google" aria-hidden="true"></ion-icon>
                Google Calendar
              </button>
              <button type="button" id="ics-btn" role="menuitem">
                <ion-icon name="download-outline" aria-hidden="true"></ion-icon>
                Download .ics file
              </button>
            </div>
          </div>
          <button type="button" class="btn btn-ghost" id="png-btn" hidden>
            Save as image
          </button>
        </div>
      </div>
    </main>

    <div class="export-sheet" id="export-sheet" aria-hidden="true">
      <div class="export-head">
        <p class="export-label" id="export-label"></p>
        <p class="export-meta" id="export-meta"></p>
      </div>
      <div class="export-months" id="export-months"></div>
      <div class="export-brand">
        <img
          src="/media/side-projects/guardias/icon.png"
          width="18"
          height="18"
          alt=""
        />
        <span>DeGuardia</span>
      </div>
    </div>

    <div class="png-sheet" id="png-sheet" hidden>
      <div
        class="png-sheet-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="png-sheet-title"
      >
        <p class="png-sheet-hint" id="png-sheet-title">
          Long-press the image to save to Photos
        </p>
        <img id="png-sheet-img" alt="Rotation schedule" />
        <button type="button" class="btn" id="png-share-btn" hidden>
          Share image
        </button>
        <button type="button" class="btn btn-secondary" id="png-close-btn">
          Close
        </button>
      </div>
    </div>

    <script
      type="module"
      src="https://unpkg.com/ionicons@8.1.0/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@8.1.0/dist/ionicons/ionicons.js"
    ></script>
    <script>
      import { toPng } from "html-to-image";

      (function () {
        type OffsetLetter = "A" | "B" | "C" | "D";
        type Draft = {
          label: string;
          startDate: string;
          endDate: string;
          pattern: { cycleDays: 3 | 4; offset: OffsetLetter };
          firstShiftDate: string | null;
          vacationStartDate: string | null;
          vacationEndDate: string | null;
          shiftStartTime: string;
          color: string;
        };
        type DaySet = Record<string, boolean>;

        var ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;
        var HH_MM = /^\d{2}:\d{2}$/;
        var HEX = /^#[0-9A-Fa-f]{6}$/;
        var OFFSET_INDEX: Record<OffsetLetter, number> = {
          A: 0,
          B: 1,
          C: 2,
          D: 3,
        };
        var DOW_ES = ["L", "M", "M", "J", "V", "S", "D"];

        function decodeBase64Url(payload: string): string | null {
          try {
            var padded =
              payload.replace(/-/g, "+").replace(/_/g, "/") +
              "===".slice((payload.length + 3) % 4);
            var binary = atob(padded);
            var bytes = new Uint8Array(binary.length);
            for (var i = 0; i < binary.length; i += 1) {
              bytes[i] = binary.charCodeAt(i);
            }
            return new TextDecoder().decode(bytes);
          } catch (e) {
            return null;
          }
        }

        function parseLocalDate(iso: string): Date {
          var parts = iso.split("-");
          return new Date(
            Number(parts[0]),
            Number(parts[1]) - 1,
            Number(parts[2]),
          );
        }

        function toISODate(date: Date): string {
          var y = date.getFullYear();
          var m = String(date.getMonth() + 1).padStart(2, "0");
          var d = String(date.getDate()).padStart(2, "0");
          return y + "-" + m + "-" + d;
        }

        function addDays(iso: string, n: number): string {
          var date = parseLocalDate(iso);
          date.setDate(date.getDate() + n);
          return toISODate(date);
        }

        function daysBetween(a: string, b: string): number {
          var ms =
            parseLocalDate(b).getTime() - parseLocalDate(a).getTime();
          return Math.round(ms / 86400000);
        }

        function formatRange(start: string, end: string): string {
          var opts: Intl.DateTimeFormatOptions = {
            month: "long",
            day: "numeric",
          };
          return (
            parseLocalDate(start).toLocaleDateString("en-US", opts) +
            " – " +
            parseLocalDate(end).toLocaleDateString("en-US", opts)
          );
        }

        function toYearMonth(iso: string): string {
          return iso.slice(0, 7);
        }

        function monthsInRange(startDate: string, endDate: string): string[] {
          var months: string[] = [];
          var cursor = toYearMonth(startDate);
          var endYm = toYearMonth(endDate);
          while (cursor <= endYm) {
            months.push(cursor);
            var parts = cursor.split("-");
            var y = Number(parts[0]);
            var m = Number(parts[1]);
            if (m === 12) {
              y += 1;
              m = 1;
            } else {
              m += 1;
            }
            cursor = y + "-" + String(m).padStart(2, "0");
          }
          return months;
        }

        function firstOfMonth(ym: string): string {
          return ym + "-01";
        }

        function lastOfMonth(ym: string): string {
          var parts = ym.split("-");
          var y = Number(parts[0]);
          var m = Number(parts[1]);
          return toISODate(new Date(y, m, 0));
        }

        function monthLabel(ym: string): string {
          return parseLocalDate(firstOfMonth(ym)).toLocaleDateString("en-US", {
            month: "long",
          });
        }

        function patternLabel(cycleDays: number, offset: string): string {
          var cycle = cycleDays === 3 ? "A–C" : "A–D";
          return cycle + " · " + offset;
        }

        function isOnVacation(draft: Draft, iso: string): boolean {
          if (!draft.vacationStartDate || !draft.vacationEndDate) return false;
          return (
            iso >= draft.vacationStartDate && iso <= draft.vacationEndDate
          );
        }

        function matchesYearLetter(
          iso: string,
          cycleDays: number,
          offset: OffsetLetter,
        ): boolean {
          var date = parseLocalDate(iso);
          var jan1 = new Date(date.getFullYear(), 0, 1);
          var daysFromJan1 = Math.round(
            (date.getTime() - jan1.getTime()) / 86400000,
          );
          var index = ((daysFromJan1 % cycleDays) + cycleDays) % cycleDays;
          return index === OFFSET_INDEX[offset];
        }

        function matchesFirstShiftCycle(
          iso: string,
          firstShiftDate: string,
          cycleDays: number,
        ): boolean {
          var days = daysBetween(firstShiftDate, iso);
          return ((days % cycleDays) + cycleDays) % cycleDays === 0;
        }

        function isShiftDay(draft: Draft, iso: string): boolean {
          if (iso < draft.startDate || iso > draft.endDate) return false;
          if (isOnVacation(draft, iso)) return false;
          if (draft.firstShiftDate) {
            return matchesFirstShiftCycle(
              iso,
              draft.firstShiftDate,
              draft.pattern.cycleDays,
            );
          }
          return matchesYearLetter(
            iso,
            draft.pattern.cycleDays,
            draft.pattern.offset,
          );
        }

        function mondayOnOrBefore(iso: string): string {
          var date = parseLocalDate(iso);
          var day = date.getDay();
          var back = day === 0 ? 6 : day - 1;
          date.setDate(date.getDate() - back);
          return toISODate(date);
        }

        function buildShiftSet(draft: Draft, from: string, to: string): DaySet {
          var set: DaySet = {};
          var cursor = from;
          while (cursor <= to) {
            if (isShiftDay(draft, cursor)) set[cursor] = true;
            cursor = addDays(cursor, 1);
          }
          return set;
        }

        /** Sat/Sun marked when Fri+Sat+Sun are all clear of shifts. */
        function freeWeekendSet(
          shiftSet: DaySet,
          from: string,
          to: string,
        ): DaySet {
          var free: DaySet = {};
          var cursor = mondayOnOrBefore(from);
          var end = to;
          while (cursor <= end) {
            var sat = addDays(cursor, 5);
            var fri = addDays(cursor, 4);
            var sun = addDays(cursor, 6);
            if (
              !shiftSet[fri] &&
              !shiftSet[sat] &&
              !shiftSet[sun] &&
              ((sat >= from && sat <= to) || (sun >= from && sun <= to))
            ) {
              if (sat >= from && sat <= to) free[sat] = true;
              if (sun >= from && sun <= to) free[sun] = true;
            }
            cursor = addDays(cursor, 7);
          }
          return free;
        }

        function parseDraft(raw: unknown): Draft | null {
          if (raw == null || typeof raw !== "object") return null;
          var data = raw as Record<string, unknown>;
          var patternRaw = data.pattern;
          if (patternRaw == null || typeof patternRaw !== "object") return null;
          var pattern = patternRaw as Record<string, unknown>;
          var cycleDays = pattern.cycleDays;
          var offset = pattern.offset;
          if (cycleDays !== 3 && cycleDays !== 4) return null;
          if (typeof offset !== "string" || !(offset in OFFSET_INDEX))
            return null;
          var offsetLetter = offset as OffsetLetter;
          if (cycleDays === 3 && offsetLetter === "D") return null;
          if (typeof data.label !== "string" || !data.label.trim()) return null;
          if (
            typeof data.startDate !== "string" ||
            typeof data.endDate !== "string" ||
            !ISO_DATE.test(data.startDate) ||
            !ISO_DATE.test(data.endDate)
          )
            return null;
          if (data.endDate < data.startDate) return null;
          var firstShiftDate =
            data.firstShiftDate === null ||
            (typeof data.firstShiftDate === "string" &&
              ISO_DATE.test(data.firstShiftDate))
              ? (data.firstShiftDate as string | null)
              : null;
          var vacationStartDate =
            data.vacationStartDate === null ||
            (typeof data.vacationStartDate === "string" &&
              ISO_DATE.test(data.vacationStartDate))
              ? (data.vacationStartDate as string | null)
              : null;
          var vacationEndDate =
            data.vacationEndDate === null ||
            (typeof data.vacationEndDate === "string" &&
              ISO_DATE.test(data.vacationEndDate))
              ? (data.vacationEndDate as string | null)
              : null;
          var shiftStartTime =
            typeof data.shiftStartTime === "string" &&
            HH_MM.test(data.shiftStartTime)
              ? data.shiftStartTime
              : "07:00";
          var color =
            typeof data.color === "string" && HEX.test(data.color)
              ? data.color
              : "#DC211E";

          return {
            label: data.label.trim(),
            startDate: data.startDate,
            endDate: data.endDate,
            pattern: { cycleDays: cycleDays, offset: offsetLetter },
            firstShiftDate: firstShiftDate,
            vacationStartDate: vacationStartDate,
            vacationEndDate: vacationEndDate,
            shiftStartTime: shiftStartTime,
            color: color,
          };
        }

        function pad2(n: number): string {
          return String(n).padStart(2, "0");
        }

        function formatIcsLocal(isoDate: string, hhmm: string): string {
          var parts = hhmm.split(":");
          return (
            isoDate.replace(/-/g, "") +
            "T" +
            parts[0] +
            parts[1] +
            "00"
          );
        }

        function formatIcsUtcNow(): string {
          var d = new Date();
          return (
            d.getUTCFullYear() +
            pad2(d.getUTCMonth() + 1) +
            pad2(d.getUTCDate()) +
            "T" +
            pad2(d.getUTCHours()) +
            pad2(d.getUTCMinutes()) +
            pad2(d.getUTCSeconds()) +
            "Z"
          );
        }

        function escapeIcsText(value: string): string {
          return String(value)
            .replace(/\\/g, "\\\\")
            .replace(/;/g, "\\;")
            .replace(/,/g, "\\,")
            .replace(/\r\n|\n|\r/g, "\\n");
        }

        function slugFilename(label: string, ext?: string): string {
          var slug = label
            .toLowerCase()
            .replace(/[^a-z0-9]+/g, "-")
            .replace(/^-+|-+$/g, "")
            .slice(0, 48);
          return (slug || "rotation") + (ext || ".ics");
        }

        /** 24h overnight shifts: end is start time on the next calendar day. */
        function buildIcs(draft: Draft): { ics: string; count: number } {
          var stamp = formatIcsUtcNow();
          var summary = escapeIcsText(draft.label);
          var lines = [
            "BEGIN:VCALENDAR",
            "VERSION:2.0",
            "PRODID:-//DeGuardia//EN",
            "CALSCALE:GREGORIAN",
            "METHOD:PUBLISH",
            "X-WR-CALNAME:" + summary,
          ];
          var cursor = draft.startDate;
          var count = 0;
          while (cursor <= draft.endDate) {
            if (isShiftDay(draft, cursor)) {
              var endDate = addDays(cursor, 1);
              var uid =
                "guardia-" +
                cursor.replace(/-/g, "") +
                "-" +
                draft.pattern.cycleDays +
                draft.pattern.offset +
                "@alanmatias.com";
              lines.push(
                "BEGIN:VEVENT",
                "UID:" + uid,
                "DTSTAMP:" + stamp,
                "DTSTART:" + formatIcsLocal(cursor, draft.shiftStartTime),
                "DTEND:" + formatIcsLocal(endDate, draft.shiftStartTime),
                "SUMMARY:" + summary,
                "DESCRIPTION:" +
                  escapeIcsText(
                    "Shared from DeGuardia · " +
                      patternLabel(
                        draft.pattern.cycleDays,
                        draft.pattern.offset,
                      ),
                  ),
                "END:VEVENT",
              );
              count += 1;
            }
            cursor = addDays(cursor, 1);
          }
          lines.push("END:VCALENDAR");
          return { ics: lines.join("\r\n") + "\r\n", count: count };
        }

        function downloadIcs(draft: Draft): void {
          var built = buildIcs(draft);
          if (!built.count) return;
          var blob = new Blob([built.ics], {
            type: "text/calendar;charset=utf-8",
          });
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = slugFilename(draft.label);
          document.body.append(a);
          a.click();
          a.remove();
          URL.revokeObjectURL(url);
        }

        /** True when vacation removes at least one otherwise-scheduled shift. */
        function vacationBreaksCycle(draft: Draft): boolean {
          if (!draft.vacationStartDate || !draft.vacationEndDate) return false;
          var cursor = draft.startDate;
          while (cursor <= draft.endDate) {
            if (
              cursor >= draft.vacationStartDate &&
              cursor <= draft.vacationEndDate
            ) {
              var withoutVacation = Object.assign({}, draft, {
                vacationStartDate: null,
                vacationEndDate: null,
              });
              if (isShiftDay(withoutVacation, cursor)) return true;
            }
            cursor = addDays(cursor, 1);
          }
          return false;
        }

        function firstAndCountShifts(draft: Draft): {
          first: string | null;
          count: number;
        } {
          var first: string | null = null;
          var count = 0;
          var cursor = draft.startDate;
          while (cursor <= draft.endDate) {
            if (isShiftDay(draft, cursor)) {
              if (!first) first = cursor;
              count += 1;
            }
            cursor = addDays(cursor, 1);
          }
          return { first: first, count: count };
        }

        /**
         * One recurring event via Google’s TEMPLATE URL.
         * Only valid when shifts are a clean every-N-days cycle (no vacation gaps).
         */
        function buildGoogleCalendarUrl(draft: Draft): string | null {
          var shiftInfo = firstAndCountShifts(draft);
          if (!shiftInfo.first || !shiftInfo.count) return null;
          var endDate = addDays(shiftInfo.first, 1);
          var dates =
            formatIcsLocal(shiftInfo.first, draft.shiftStartTime) +
            "/" +
            formatIcsLocal(endDate, draft.shiftStartTime);
          var params = new URLSearchParams();
          params.set("action", "TEMPLATE");
          params.set("text", draft.label);
          params.set("dates", dates);
          params.set(
            "details",
            "Shared from DeGuardia · " +
              patternLabel(draft.pattern.cycleDays, draft.pattern.offset),
          );
          params.set(
            "recur",
            "RRULE:FREQ=DAILY;INTERVAL=" +
              draft.pattern.cycleDays +
              ";COUNT=" +
              shiftInfo.count,
          );
          return (
            "https://calendar.google.com/calendar/render?" + params.toString()
          );
        }

        function exportToGoogleCalendar(draft: Draft): void {
          if (vacationBreaksCycle(draft)) {
            downloadIcs(draft);
            window.open(
              "https://calendar.google.com/calendar/u/0/r/settings/import",
              "_blank",
              "noopener,noreferrer",
            );
            return;
          }
          var url = buildGoogleCalendarUrl(draft);
          if (!url) return;
          window.open(url, "_blank", "noopener,noreferrer");
        }

        function fillDows(dowsTarget: HTMLElement): void {
          dowsTarget.replaceChildren();
          for (var d = 0; d < 7; d += 1) {
            var dow = document.createElement("span");
            dow.className = "cal-dow";
            dow.textContent = DOW_ES[d];
            dowsTarget.append(dow);
          }
        }

        function fillWeeks(
          weeksTarget: HTMLElement,
          draft: Draft,
          ym: string,
          todayIso: string,
          markToday: boolean,
        ): void {
          var monthStart = firstOfMonth(ym);
          var monthEnd = lastOfMonth(ym);
          var gridStart = mondayOnOrBefore(monthStart);
          var gridEnd = addDays(mondayOnOrBefore(monthEnd), 6);
          var shiftSet = buildShiftSet(
            draft,
            addDays(gridStart, -1),
            addDays(gridEnd, 1),
          );
          var freeSet = freeWeekendSet(shiftSet, gridStart, gridEnd);
          var daySpan = Math.round(
            (parseLocalDate(gridEnd).getTime() -
              parseLocalDate(gridStart).getTime()) /
              86400000,
          );
          var weekCount = (daySpan + 1) / 7;

          weeksTarget.replaceChildren();
          for (var w = 0; w < weekCount; w += 1) {
            var week = document.createElement("div");
            week.className = "cal-week";
            var weekStart = addDays(gridStart, w * 7);
            var sat = addDays(weekStart, 5);
            var sun = addDays(weekStart, 6);
            var satInMonth = toYearMonth(sat) === ym;
            var sunInMonth = toYearMonth(sun) === ym;
            var satInRange =
              sat >= draft.startDate && sat <= draft.endDate;
            var sunInRange =
              sun >= draft.startDate && sun <= draft.endDate;
            if (
              satInMonth &&
              sunInMonth &&
              satInRange &&
              sunInRange &&
              freeSet[sat] &&
              freeSet[sun]
            ) {
              var pill = document.createElement("div");
              pill.className = "cal-weekend-pill";
              week.append(pill);
            }
            for (var i = 0; i < 7; i += 1) {
              var iso = addDays(weekStart, i);
              var date = parseLocalDate(iso);
              var inMonth = toYearMonth(iso) === ym;
              var inRange =
                iso >= draft.startDate && iso <= draft.endDate;
              var shift = inMonth && !!shiftSet[iso];
              var weekend = inMonth && inRange && !!freeSet[iso];
              var isToday = markToday && inMonth && iso === todayIso;
              var cell = document.createElement("div");
              cell.className = "cal-cell";
              var mark = document.createElement("span");
              var classes = ["cal-mark"];
              if (!inMonth) classes.push("outside");
              if (shift) classes.push("shift");
              if (weekend) classes.push("weekend");
              if (isToday) classes.push("today");
              mark.className = classes.join(" ");
              if (shift && isToday) {
                var inner = document.createElement("span");
                inner.className = "cal-mark-inner";
                inner.style.background = draft.color;
                inner.textContent = String(date.getDate());
                mark.append(inner);
              } else {
                mark.textContent = String(date.getDate());
                if (shift) {
                  mark.style.background = draft.color;
                }
              }
              cell.append(mark);
              week.append(cell);
            }
            weeksTarget.append(week);
          }
        }

        function buildExportMonths(
          exportMonthsEl: HTMLElement,
          draft: Draft,
          months: string[],
          todayIso: string,
        ): void {
          exportMonthsEl.replaceChildren();
          for (var m = 0; m < months.length; m += 1) {
            var ym = months[m];
            var card = document.createElement("article");
            card.className = "export-month";
            var cal = document.createElement("div");
            cal.className = "cal";
            var monthEl = document.createElement("p");
            monthEl.className = "cal-month";
            monthEl.textContent = monthLabel(ym);
            var dows = document.createElement("div");
            dows.className = "cal-dows";
            fillDows(dows);
            var weeks = document.createElement("div");
            weeks.className = "cal-weeks";
            fillWeeks(weeks, draft, ym, todayIso, false);
            cal.append(monthEl, dows, weeks);
            card.append(cal);
            exportMonthsEl.append(card);
          }
        }

        function isMobilePlatform(): boolean {
          return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent || "");
        }

        function dataUrlToBlob(dataUrl: string): Blob {
          var comma = dataUrl.indexOf(",");
          var header = dataUrl.slice(0, comma);
          var data = dataUrl.slice(comma + 1);
          var mimeMatch = /data:([^;]+)/.exec(header);
          var mime = mimeMatch ? mimeMatch[1] : "image/png";
          var binary = atob(data);
          var bytes = new Uint8Array(binary.length);
          for (var i = 0; i < binary.length; i += 1) {
            bytes[i] = binary.charCodeAt(i);
          }
          return new Blob([bytes], { type: mime });
        }

        function triggerBlobDownload(blob: Blob, filename: string): void {
          var url = URL.createObjectURL(blob);
          var a = document.createElement("a");
          a.href = url;
          a.download = filename;
          document.body.append(a);
          a.click();
          a.remove();
          window.setTimeout(function () {
            URL.revokeObjectURL(url);
          }, 2000);
        }

        var pngSheetObjectUrl: string | null = null;

        function closePngSheet(): void {
          var sheetEl = document.getElementById("png-sheet");
          var imgEl = document.getElementById(
            "png-sheet-img",
          ) as HTMLImageElement | null;
          if (sheetEl) sheetEl.hidden = true;
          if (imgEl) imgEl.removeAttribute("src");
          if (pngSheetObjectUrl) {
            URL.revokeObjectURL(pngSheetObjectUrl);
            pngSheetObjectUrl = null;
          }
        }

        function showPngSheet(blob: Blob, file: File, title: string): void {
          var sheetEl = document.getElementById("png-sheet");
          var imgEl = document.getElementById(
            "png-sheet-img",
          ) as HTMLImageElement | null;
          var shareBtn = document.getElementById(
            "png-share-btn",
          ) as HTMLButtonElement | null;
          var closeBtn = document.getElementById("png-close-btn");
          if (!sheetEl || !imgEl || !shareBtn || !closeBtn) {
            triggerBlobDownload(blob, file.name);
            return;
          }

          if (pngSheetObjectUrl) URL.revokeObjectURL(pngSheetObjectUrl);
          pngSheetObjectUrl = URL.createObjectURL(blob);
          imgEl.src = pngSheetObjectUrl;
          imgEl.alt = title;

          var canShareFiles =
            typeof navigator.canShare === "function" &&
            navigator.canShare({ files: [file] });
          shareBtn.hidden = !canShareFiles;
          shareBtn.onclick = function () {
            if (!canShareFiles) return;
            navigator
              .share({ files: [file], title: title })
              .catch(function () {});
          };
          closeBtn.onclick = closePngSheet;
          sheetEl.onclick = function (event) {
            if (event.target === sheetEl) closePngSheet();
          };
          sheetEl.hidden = false;
        }

        function downloadPng(draft: Draft, sheet: HTMLElement): Promise<void> {
          // Capture the offscreen sheet; force the clone on-screen and opaque
          // (mutating opacity:0 on the live node paints a blank PNG).
          // Mobile browsers often ignore <a download> after async work, so we
          // use the share sheet / an in-page image the user can long-press.
          var filename = slugFilename(draft.label, ".png");
          return document.fonts.ready
            .then(function () {
              return toPng(sheet, {
                pixelRatio: 2,
                cacheBust: true,
                backgroundColor: "#171616",
                style: {
                  position: "fixed",
                  left: "0",
                  top: "0",
                  right: "auto",
                  bottom: "auto",
                  transform: "none",
                  opacity: "1",
                  zIndex: "-1",
                },
              });
            })
            .then(function (dataUrl) {
              var blob = dataUrlToBlob(dataUrl);
              var file = new File([blob], filename, { type: "image/png" });
              var canShareFiles =
                typeof navigator.canShare === "function" &&
                navigator.canShare({ files: [file] });

              if (!isMobilePlatform()) {
                triggerBlobDownload(blob, filename);
                return;
              }

              if (canShareFiles) {
                return navigator
                  .share({ files: [file], title: draft.label })
                  .catch(function (err: unknown) {
                    var name =
                      err && typeof err === "object" && "name" in err
                        ? String((err as { name: string }).name)
                        : "";
                    if (name === "AbortError") return;
                    // Gesture often expires after toPng — show a sheet so the
                    // next tap can share, or the user can long-press to save.
                    showPngSheet(blob, file, draft.label);
                  });
              }

              showPngSheet(blob, file, draft.label);
            });
        }

        var APP_STORE_URL = "https://apps.apple.com/app/id6803777786";
        var PLAY_STORE_URL =
          "https://play.google.com/store/apps/details?id=com.alanmatias.guardias";
        var APP_OPEN_TIMEOUT_MS = 1600;

        function detectPlatform(): "android" | "ios" | "other" {
          var ua = navigator.userAgent || "";
          if (/android/i.test(ua)) return "android";
          if (/iPad|iPhone|iPod/.test(ua)) return "ios";
          return "other";
        }

        /**
         * Mobile: one “Open in DeGuardia App” button — try miguardia://, then
         * the matching store. Desktop: side-by-side iOS / Google Play (no
         * custom-scheme attempt; desktop can’t open the phone app).
         */
        function wireOpenInAppButton(payload: string) {
          var storeBtn = document.getElementById(
            "store-btn",
          ) as HTMLAnchorElement | null;
          var storePair = document.getElementById("store-pair");
          var iosStoreBtn = document.getElementById(
            "ios-store-btn",
          ) as HTMLAnchorElement | null;
          var playStoreBtn = document.getElementById(
            "play-store-btn",
          ) as HTMLAnchorElement | null;
          if (!storeBtn || !storePair) return;

          var platform = detectPlatform();

          if (platform === "other") {
            storeBtn.hidden = true;
            storePair.hidden = false;
            if (iosStoreBtn) iosStoreBtn.href = APP_STORE_URL;
            if (playStoreBtn) playStoreBtn.href = PLAY_STORE_URL;
            return;
          }

          storeBtn.hidden = false;
          storePair.hidden = true;

          var storeBtnIcon = document.getElementById("store-btn-icon");
          var storeBtnLabel = document.getElementById("store-btn-label");
          var primaryStoreUrl =
            platform === "android" ? PLAY_STORE_URL : APP_STORE_URL;
          storeBtn.href = primaryStoreUrl;

          if (platform === "android") {
            if (storeBtnIcon)
              storeBtnIcon.setAttribute("name", "logo-google-playstore");
            if (storeBtnLabel)
              storeBtnLabel.textContent = "Open in Google Play";
          } else {
            if (storeBtnIcon)
              storeBtnIcon.setAttribute("name", "logo-apple");
            if (storeBtnLabel)
              storeBtnLabel.textContent = "Open in iOS App Store";
          }

          storeBtn.addEventListener("click", function (event) {
            event.preventDefault();

            var appUrl =
              "miguardia://guardias/r/?d=" + encodeURIComponent(payload);
            var leftForApp = false;
            var settled = false;

            function markLeft() {
              leftForApp = true;
            }

            function goToStore() {
              if (settled || leftForApp || document.hidden) return;
              settled = true;
              window.removeEventListener("pagehide", markLeft);
              window.removeEventListener("blur", markLeft);
              document.removeEventListener("visibilitychange", onVisibility);
              window.location.href = primaryStoreUrl;
            }

            function onVisibility() {
              if (document.hidden) markLeft();
            }

            window.addEventListener("pagehide", markLeft);
            window.addEventListener("blur", markLeft);
            document.addEventListener("visibilitychange", onVisibility);

            window.location.href = appUrl;
            window.setTimeout(goToStore, APP_OPEN_TIMEOUT_MS);
          });
        }

        var params = new URLSearchParams(window.location.search);
        var payload = params.get("d");
        if (!payload) return;

        wireOpenInAppButton(payload);

        var json = decodeBase64Url(payload);
        if (!json) return;

        var draft: Draft | null;
        try {
          draft = parseDraft(JSON.parse(json));
        } catch (e) {
          return;
        }
        if (!draft) return;

        var preview = document.getElementById("preview");
        var shareHead = document.getElementById("share-head");
        var iconEl = document.getElementById("icon");
        var labelEl = document.getElementById("label");
        var metaEl = document.getElementById("meta");
        var monthLabelEl = document.getElementById("month-label");
        var monthPrevBtn = document.getElementById(
          "month-prev",
        ) as HTMLButtonElement | null;
        var monthNextBtn = document.getElementById(
          "month-next",
        ) as HTMLButtonElement | null;
        var dowsEl = document.getElementById("dows");
        var weeksEl = document.getElementById("weeks");
        var icsMobileBtn = document.getElementById(
          "ics-mobile-btn",
        ) as HTMLButtonElement | null;
        var calMenu = document.getElementById("cal-menu");
        var calBtn = document.getElementById(
          "cal-btn",
        ) as HTMLButtonElement | null;
        var calMenuList = document.getElementById("cal-menu-list");
        var gcalBtn = document.getElementById("gcal-btn");
        var icsBtn = document.getElementById("ics-btn");
        var pngBtn = document.getElementById(
          "png-btn",
        ) as HTMLButtonElement | null;
        var copyEl = document.getElementById("copy");
        var exportSheet = document.getElementById("export-sheet");
        var exportLabel = document.getElementById("export-label");
        var exportMeta = document.getElementById("export-meta");
        var exportMonths = document.getElementById("export-months");
        if (
          !preview ||
          !shareHead ||
          !labelEl ||
          !metaEl ||
          !monthLabelEl ||
          !monthPrevBtn ||
          !monthNextBtn ||
          !dowsEl ||
          !weeksEl ||
          !exportSheet ||
          !exportLabel ||
          !exportMeta ||
          !exportMonths
        )
          return;

        var activeDraft = draft;
        var activeMonthLabel = monthLabelEl;
        var activeMonthPrev = monthPrevBtn;
        var activeMonthNext = monthNextBtn;
        var activeWeeks = weeksEl;
        var activeExportSheet = exportSheet;

        labelEl.textContent = activeDraft.label;
        metaEl.textContent = formatRange(
          activeDraft.startDate,
          activeDraft.endDate,
        );
        exportLabel.textContent = activeDraft.label;
        exportMeta.textContent = formatRange(
          activeDraft.startDate,
          activeDraft.endDate,
        );

        if (copyEl) copyEl.classList.add("has-preview");
        var icsPreview = buildIcs(activeDraft);
        if (icsPreview.count > 0) {
          if (isMobilePlatform() && icsMobileBtn) {
            icsMobileBtn.hidden = false;
            icsMobileBtn.addEventListener("click", function () {
              downloadIcs(activeDraft);
            });
          } else if (calMenu && calBtn && calMenuList) {
            var activeCalMenu = calMenu;
            var activeCalBtn = calBtn;
            var activeCalMenuList = calMenuList;
            activeCalMenu.hidden = false;
            activeCalBtn.addEventListener("click", function () {
              var open = activeCalMenuList.hidden;
              activeCalMenuList.hidden = !open;
              activeCalBtn.setAttribute(
                "aria-expanded",
                open ? "true" : "false",
              );
            });
            if (gcalBtn) {
              gcalBtn.addEventListener("click", function () {
                exportToGoogleCalendar(activeDraft);
                activeCalMenuList.hidden = true;
                activeCalBtn.setAttribute("aria-expanded", "false");
              });
            }
            if (icsBtn) {
              icsBtn.addEventListener("click", function () {
                downloadIcs(activeDraft);
                activeCalMenuList.hidden = true;
                activeCalBtn.setAttribute("aria-expanded", "false");
              });
            }
          }
        }

        var months = monthsInRange(activeDraft.startDate, activeDraft.endDate);
        var todayIso = toISODate(new Date());
        var todayYm = toYearMonth(todayIso);
        var monthIndex = months.indexOf(todayYm);
        if (monthIndex < 0) monthIndex = 0;

        buildExportMonths(exportMonths, activeDraft, months, todayIso);
        if (pngBtn) {
          var activePngBtn = pngBtn;
          activePngBtn.hidden = false;
          activePngBtn.addEventListener("click", function () {
            if (activePngBtn.disabled) return;
            activePngBtn.disabled = true;
            downloadPng(activeDraft, activeExportSheet)
              .catch(function () {})
              .then(function () {
                activePngBtn.disabled = false;
              });
          });
        }

        fillDows(dowsEl);

        function updateNav() {
          activeMonthPrev.disabled = monthIndex <= 0;
          activeMonthNext.disabled = monthIndex >= months.length - 1;
        }

        function renderMonth(ym: string) {
          activeMonthLabel.textContent = monthLabel(ym);
          fillWeeks(activeWeeks, activeDraft, ym, todayIso, true);
          updateNav();
        }

        activeMonthPrev.addEventListener("click", function () {
          if (monthIndex <= 0) return;
          monthIndex -= 1;
          renderMonth(months[monthIndex]);
        });
        activeMonthNext.addEventListener("click", function () {
          if (monthIndex >= months.length - 1) return;
          monthIndex += 1;
          renderMonth(months[monthIndex]);
        });

        renderMonth(months[monthIndex]);

        if (iconEl) iconEl.hidden = true;
        shareHead.hidden = false;
        preview.hidden = false;
      })();
    </script>
  </body>
</html>
