---
import DocumentHead from "@/components/DocumentHead.astro";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const { title, description, type } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <DocumentHead title={title} description={description} type={type} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-muted focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div class="mx-auto w-full max-w-3xl px-6 py-16 md:px-8 md:py-24">
      <slot />
    </div>
  </body>
</html>
