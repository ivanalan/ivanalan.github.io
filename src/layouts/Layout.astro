---
import DocumentHead from "@/components/DocumentHead.astro";
import { HeaderArt } from "@/components/HeaderArt";
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  /** Skip the default reading-width shell (explore tools, etc.). */
  fullBleed?: boolean;
  /** Dithered warp band behind the top of the page (home pages). */
  headerArt?: boolean;
}

const {
  title,
  description,
  type,
  fullBleed = false,
  headerArt = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <DocumentHead title={title} description={description} type={type} />
  </head>
  <body class={headerArt ? "relative" : undefined}>
    {headerArt && <HeaderArt client:load />}
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-muted focus:px-3 focus:py-2"
    >
      Skip to content
    </a>
    <div
      class={
        fullBleed
          ? "w-full"
          : "mx-auto w-full max-w-4xl px-6 py-16 md:px-8 md:py-24"
      }
    >
      <slot />
    </div>
  </body>
</html>
