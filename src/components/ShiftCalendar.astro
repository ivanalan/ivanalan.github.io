---
/* The month calendar from DeGuardia: day markers on a soft radius, one
   24-hour shift every fourth day. A weekend only counts as free when
   Friday, Saturday, and Sunday are all clear, because a Friday shift
   ends Saturday morning. Header + legend frame it as a case-study figure. */
const DAYS_IN_MONTH = 31;
/* Monday-first index of the first day. Opening on a Saturday is what walks the
   shift through every weekday and leaves exactly one weekend standing. */
const FIRST_WEEKDAY = 5;
const WEEKDAYS = ["M", "T", "W", "T", "F", "S", "S"];
const MARK = "2.5rem";
const MARK_R = "0.9rem";
const MARK_HALF = "1.25rem";

const weekdayOf = (day: number) => (FIRST_WEEKDAY + day - 1) % 7;
const isShift = (day: number) => (day - 1) % 4 === 0;

const startsFreeWeekend = (day: number) =>
  weekdayOf(day) === 5 &&
  day > 1 &&
  day + 1 <= DAYS_IN_MONTH &&
  !isShift(day - 1) &&
  !isShift(day) &&
  !isShift(day + 1);

const isFreeWeekend = (day: number) =>
  startsFreeWeekend(day) ||
  (weekdayOf(day) === 6 && startsFreeWeekend(day - 1));

/* Leading blanks instead of the previous month's days: the card names the
   idea ("one free weekend"), not a calendar month. */
const cells: (number | null)[] = [
  ...Array.from({ length: FIRST_WEEKDAY }, () => null),
  ...Array.from({ length: DAYS_IN_MONTH }, (_, index) => index + 1),
];
const weeks = Array.from({ length: Math.ceil(cells.length / 7) }, (_, week) =>
  Array.from({ length: 7 }, (_, day) => cells[week * 7 + day] ?? null),
);
---

{/* Held to the prose column so the card centers on the body copy, not on the
    wider article column. */}
<figure class="mx-auto max-w-prose">
  <div
    class="mx-auto w-full max-w-[28rem] rounded-[1.5rem] bg-secondary px-6 py-5"
    style="--shift-mark: #c11e1e; --weekend-mark: #0a6a42"
    role="img"
    aria-label="A month laid out as a calendar. A 24-hour shift falls every fourth day, landing on a different weekday each week. Only one weekend has no shift on its Friday, Saturday, or Sunday."
  >
    <div class="mb-3 font-heading text-lg text-foreground">
      One free weekend
    </div>
    <div class="grid grid-cols-7">
      {
        WEEKDAYS.map((letter) => (
          <span class="text-center font-mono text-sm text-foreground">
            {letter}
          </span>
        ))
      }
    </div>
    <div class="mt-2 flex flex-col gap-2">
      {
        weeks.map((week) => (
          <div class="relative grid grid-cols-7">
            {/* One capsule spanning Saturday to Sunday, drawn from Saturday's
                column center to Sunday's, plus half a marker at each end. */}
            {week.some((day) => day !== null && startsFreeWeekend(day)) && (
              <div
                class="absolute top-0 bg-[var(--weekend-mark)]"
                style={`height: ${MARK}; border-radius: ${MARK_R}; left: calc(78.5714% - ${MARK_HALF}); width: calc(14.2857% + ${MARK})`}
              />
            )}
            {week.map((day) => (
              <span
                class="flex items-center justify-center"
                style={`height: ${MARK}`}
              >
                {day !== null && (
                  <span
                    class:list={[
                      "relative flex items-center justify-center font-mono text-sm",
                      isShift(day)
                        ? "bg-[var(--shift-mark)] text-white"
                        : isFreeWeekend(day)
                          ? "text-white"
                          : "text-foreground",
                    ]}
                    style={`width: ${MARK}; height: ${MARK}; border-radius: ${MARK_R}`}
                  >
                    {day}
                  </span>
                )}
              </span>
            ))}
          </div>
        ))
      }
    </div>
    <div
      class="mt-3.5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-muted-foreground"
    >
      <span class="inline-flex items-center gap-1.5">
        <i
          class="inline-block size-3 rounded-sm bg-[var(--shift-mark)]"
          aria-hidden="true"
        />
        24h shift
      </span>
      <span class="inline-flex items-center gap-1.5">
        <i
          class="inline-block size-3 rounded-sm bg-[var(--weekend-mark)]"
          aria-hidden="true"
        />
        free weekend
      </span>
    </div>
  </div>
  <figcaption>Shift every fourth day. Only one weekend survives.</figcaption>
</figure>
