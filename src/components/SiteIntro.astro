---
import { site } from "@/lib/site";
---

<header class="flex flex-col gap-2">
  <div class="flex flex-col gap-0.5">
    <h1 class="reveal text-name text-foreground" style="--reveal-index: 0">
      {site.name}
    </h1>
    <p class="reveal text-base text-muted-foreground" style="--reveal-index: 1">
      {site.role}
    </p>
  </div>
  <div class="flex flex-col gap-1">
    <p
      class="reveal text-base leading-[1.7] text-foreground"
      style="--reveal-index: 2"
    >
      3+ years shipping products, from scrappy work at Ab Initio to scale at
      Qualtrics. My computer science background shows up in how I think about
      systems, ship code, and measure analytics.
    </p>
  </div>
</header>
