---
import { site } from "@/lib/site";
---

<header class="flex flex-col gap-4">
  <div class="flex flex-col gap-0.5">
    <h1 class="reveal text-name text-foreground" style="--reveal-index: 0">
      {site.name}
    </h1>
    <p class="reveal text-base text-muted-foreground" style="--reveal-index: 1">
      <span class="shimmer shimmer-color-foreground shimmer-spread-8">
        {site.role}
      </span>
    </p>
  </div>
  <p
    class="reveal text-base text-foreground"
    style="--reveal-index: 2"
  >
    {site.description}
  </p>
</header>
